<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SprocketPartClipboard</AssemblyName>
    <RootNamespace>SprocketPartClipboard</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.1</Version>
    <Description>在 Sprocket 载具设计器中复制与粘贴整棵部件子树。</Description>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == '' and '$(SPROCKET_GAME_ROOT)' != ''">$(SPROCKET_GAME_ROOT)</SprocketGameRoot>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..'))</SprocketGameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(SprocketGameRoot)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SprocketGameRoot)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(SprocketGameRoot)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Core">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Inputs">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Inputs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.IO">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Operations">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Operations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.VehicleDesigner">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.VehicleDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.VehicleDesigner.Access">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.VehicleDesigner.Access.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.VehicleDesigner.PlayerState">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.VehicleDesigner.PlayerState.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Vehicles">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.VehicleFramework">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.VehicleFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Blueprints">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Blueprints.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Vehicles.Weapons">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Vehicles.Weapons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.WeaponFramework">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.WeaponFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.AmmoRackDesigner">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.AmmoRackDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.LayingDriveDesigner">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.LayingDriveDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Vehicles.Mantlets">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Vehicles.Mantlets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Motors">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Motors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.TurretDesign">
      <HintPath>$(SprocketGameRoot)\MelonLoader\Il2CppAssemblies\Il2CppSprocket.TurretDesign.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SprocketModAPI">
      <HintPath>$(SprocketGameRoot)\Mods\SprocketModAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploying into the game directory is deliberate: pass -p:DeployMod=true for an in-game test run. -->
  <Target Name="DeployMod" AfterTargets="PostBuildEvent" Condition="'$(DeployMod)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SprocketGameRoot)\Mods" />
  </Target>
</Project>
