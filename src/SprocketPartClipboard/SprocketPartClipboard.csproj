<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SprocketPartClipboard</AssemblyName>
    <RootNamespace>SprocketPartClipboard</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Description>在 Sprocket 载具设计器中复制与粘贴整棵部件子树。</Description>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == '' and '$(SPROCKET_GAME_ROOT)' != ''">$(SPROCKET_GAME_ROOT)</SprocketGameRoot>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == ''">G:\Sprocket0.2.55.5</SprocketGameRoot>
    <BepInExCore>$(SprocketGameRoot)\BepInEx\core</BepInExCore>
    <GameInterop>$(SprocketGameRoot)\BepInEx\interop</GameInterop>
    <ModDeployDirectory Condition="'$(ModDeployDirectory)' == ''">$(SprocketGameRoot)\BepInEx\plugins</ModDeployDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameInterop)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameInterop)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameInterop)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Core">
      <HintPath>$(GameInterop)\Sprocket.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Inputs">
      <HintPath>$(GameInterop)\Sprocket.Inputs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.IO">
      <HintPath>$(GameInterop)\Sprocket.IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Operations">
      <HintPath>$(GameInterop)\Sprocket.Operations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleDesigner">
      <HintPath>$(GameInterop)\Sprocket.VehicleDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleDesigner.Access">
      <HintPath>$(GameInterop)\Sprocket.VehicleDesigner.Access.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleDesigner.PlayerState">
      <HintPath>$(GameInterop)\Sprocket.VehicleDesigner.PlayerState.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Vehicles">
      <HintPath>$(GameInterop)\Sprocket.Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleFramework">
      <HintPath>$(GameInterop)\Sprocket.VehicleFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Blueprints">
      <HintPath>$(GameInterop)\Sprocket.Blueprints.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Vehicles.Weapons">
      <HintPath>$(GameInterop)\Sprocket.Vehicles.Weapons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.WeaponFramework">
      <HintPath>$(GameInterop)\Sprocket.WeaponFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.AmmoRackDesigner">
      <HintPath>$(GameInterop)\Sprocket.AmmoRackDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.LayingDriveDesigner">
      <HintPath>$(GameInterop)\Sprocket.LayingDriveDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Vehicles.Mantlets">
      <HintPath>$(GameInterop)\Sprocket.Vehicles.Mantlets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Motors">
      <HintPath>$(GameInterop)\Sprocket.Motors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.TurretDesign">
      <HintPath>$(GameInterop)\Sprocket.TurretDesign.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SprocketModAPI">
      <HintPath>$(SprocketGameRoot)\BepInEx\plugins\SprocketModAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 部署到游戏的 BepInEx\plugins；-p:SkipModDeploy=true 时只编译不部署。 -->
  <Target Name="DeployMod" AfterTargets="PostBuildEvent" Condition="'$(SkipModDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDirectory)" />
  </Target>
</Project>
